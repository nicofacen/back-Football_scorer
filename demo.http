@baseUrl = http://localhost:8080

### ==========================================
### 1 - LOGIN CLIENTE
### ==========================================

# @name loginCliente
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "cliente@demo.com",
  "password": "Cliente123!"
}

###

### ==========================================
### 2 - LOGIN ADMIN
### ==========================================

# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@demo.com",
  "password": "Admin123!"
}

###

### ==========================================
### 3 - CATALOGO PUBLICO
### ==========================================

GET {{baseUrl}}/api/productos

###

### ==========================================
### 4 - FILTRO
### ==========================================

GET {{baseUrl}}/api/productos?clubId=1

###

### ==========================================
### 5 - AGREGAR PRODUCTO A FAVORITOS
### ==========================================

POST {{baseUrl}}/api/favoritos/1
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### 6 - MIS FAVORITOS
### ==========================================

GET {{baseUrl}}/api/favoritos
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### 7 - FAVORITO DUPLICADO
### Esperado: 409 Conflict
### ==========================================

POST {{baseUrl}}/api/favoritos/1
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### 8 - PRODUCTO INEXISTENTE
### Esperado: 404 Not Found
### ==========================================

POST {{baseUrl}}/api/favoritos/99999
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### 9 - QUITAR FAVORITO
### Esperado: 204 No Content
### ==========================================

DELETE {{baseUrl}}/api/favoritos/1
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### 10 - QUITAR FAVORITO QUE YA NO EXISTE
### Ejecutar despues del request anterior
### Esperado: 404 Not Found
### ==========================================

DELETE {{baseUrl}}/api/favoritos/1
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### 11 - AGREGAR PRODUCTO AL CARRITO
### ==========================================

POST {{baseUrl}}/api/carrito/items
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "productoId": 1,
  "cantidad": 2
}

###

### ==========================================
### 12 - VER MI CARRITO
### ==========================================

GET {{baseUrl}}/api/carrito
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### 13 - CREAR ORDEN DESDE EL CARRITO
### ==========================================

POST {{baseUrl}}/api/ordenes
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### 14 - MIS ORDENES
### ==========================================

GET {{baseUrl}}/api/ordenes
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### SEGURIDAD 1 - SIN TOKEN
### Esperado: 401 Unauthorized
### ==========================================

POST {{baseUrl}}/api/productos
Content-Type: application/json

{
  "nombre": "Producto ilegal",
  "descripcion": "Debe fallar sin token",
  "precio": 1000,
  "stock": 5,
  "imagenUrl": "https://ejemplo.com/test.png",
  "clubId": 1
}

###

### ==========================================
### SEGURIDAD 2 - CLIENTE INTENTANDO CREAR PRODUCTO
### Esperado: 403 Forbidden
### ==========================================

POST {{baseUrl}}/api/productos
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Producto ilegal",
  "descripcion": "Cliente no puede crear productos",
  "precio": 1000,
  "stock": 5,
  "imagenUrl": "https://ejemplo.com/test.png",
  "clubId": 1
}

###

### ==========================================
### SEGURIDAD 3 - TOKEN MODIFICADO
### Para probar:
### 1. Copiar temporalmente un token valido del login
### 2. Cambiar una letra en el medio
### 3. Ejecutar este request
### 4. Volver a dejar PEGAR_TOKEN_MODIFICADO antes del commit
### Esperado: 401 Unauthorized
### ==========================================

GET {{baseUrl}}/api/favoritos
Authorization: Bearer PEGAR_TOKEN_MODIFICADO

###

### ==========================================
### SEGURIDAD 4 - TOKEN VENCIDO
### Para probar:
### cambiar temporalmente jwt.expiration-ms a 5000,
### reiniciar, hacer login, esperar mas de 5 segundos
### y ejecutar este request.
### Antes del commit volver a jwt.expiration-ms=86400000
### Esperado: 401 Unauthorized
### ==========================================

GET {{baseUrl}}/api/favoritos
Authorization: Bearer {{loginCliente.response.body.$.token}}

###

### ==========================================
### ADMIN SI PUEDE CREAR PRODUCTO
### Esperado: 201 Created
### ==========================================

POST {{baseUrl}}/api/productos
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Producto creado por admin",
  "descripcion": "Prueba positiva de rol ADMIN",
  "precio": 15000,
  "stock": 5,
  "imagenUrl": "https://ejemplo.com/admin.png",
  "clubId": 1
}

###